 namespace {
 bool endsWithSemicolon(const std::string& s) {
     return !s.empty() && s.back() == ';';
 }
+
+bool envEnabled(const char* name) {
+    const char* v = std::getenv(name);
+    return v && *v && std::string(v) != "0";
+}
+
+bool containsAny(const std::string& s, const std::initializer_list<const char*> needles) {
+    for (const char* needle : needles) {
+        if (s.find(needle) != std::string::npos) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool probablyUnsafeForEpat(const std::string& line) {
+    /*
+     * Real-world C libraries often contain statements that the current epat
+     * script parser cannot model safely: struct member writes, indirect calls,
+     * ternary expressions, address-of/pointer-indirection heavy statements,
+     * casts embedded in guards, and callback invocations.
+     *
+     * In summary mode we prefer a conservative "skip unsupported statement"
+     * policy over crashing the whole batch. This is enabled only when
+     * EPPATHER_EPAT_SAFE_RENDER=1, so existing exact benchmark behaviour can be
+     * preserved by leaving the variable unset.
+     */
+    if (line.empty()) {
+        return false;
+    }
+    if (containsAny(line, {"->", "?.", "(*", "&&", "||"})) {
+        return true;
+    }
+    if (containsAny(line, {"?", ":", "[", "]"})) {
+        return true;
+    }
+    if (containsAny(line, {"sizeof", "offsetof", "__attribute__", "__asm"})) {
+        return true;
+    }
+    return false;
+}
+
+void appendSafeLine(std::string& script, const std::string& line, bool addSemicolon) {
+    if (line.empty()) {
+        return;
+    }
+    const bool safeRender = envEnabled("EPPATHER_EPAT_SAFE_RENDER");
+    if (safeRender && probablyUnsafeForEpat(line)) {
+        if (envEnabled("EPPATHER_DEBUG_CRASH_TRACE")) {
+            std::cerr << "[EPAT_SAFE_RENDER] skip unsupported script line: "
+                      << line << std::endl;
+        }
+        return;
+    }
+    script += line;
+    if (addSemicolon && !endsWithSemicolon(line)) {
+        script += ";";
+    }
+    script += "\n";
+}
 }  // namespace

