  FLAGS = -g
  LINK_LIBRARIES = -Wl,-rpath,/home/zhangliwei/eppather/epat++/libz3/z3-4.12.2-x64-glibc-2.31/bin  epat++/libepat++/liblibepat++.a  epat++/epat-protocol/libepat-protocol.a  epat++/epat-protocol/grammar/antlr4-runtime/libantlr4-runtime.a  -lpthread  ../epat++/libz3/z3-4.12.2-x64-glibc-2.31/bin/libz3.so
  OBJECT_DIR = epat++/test/CMakeFiles/epat-array.dir
